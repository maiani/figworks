# Plot cosmetics for the thesis_plots example, applied by FigureCollection
# before the theme. The theme owns the typeface and base size; the collection
# owns the PNG resolution.

axes.labelsize : 9
axes.titlesize : 9
axes.linewidth : 0.8

xtick.labelsize : 8
ytick.labelsize : 8

lines.linewidth : 1.2

legend.frameon : false
